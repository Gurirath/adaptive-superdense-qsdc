  "figures": [
    {
      "file": "fig01_rate_vs_distance.png",
      "caption": "Secure rate vs distance; superdense direct only wins below the switch point; ping-pong never secure"
    },
    {
      "file": "fig02_superdense_security.png",
      "caption": "Density-matrix result: superdense gives exactly 2x key mode per verified pair; Eve's information bounded by pair entropy H(p)"
    },
    {
      "file": "fig03_switch_rule.png",
      "caption": "Closed-form switching rule eta* = (1-H)/(2-H(p.q)-H) = 1/2 for any fidelity and any qudit dimension"
    },
    {
      "file": "fig04_crossover_sensitivity.png",
      "caption": "Where superdense direct beats key mode, by memory quality; linear-optics Bell measurement never wins"
    },
    {
      "file": "fig05_attack_timeseries.png",
      "caption": "Time series of QBER, dark counts and back-reflection with three attack types; static threshold misses blinding and Trojan attacks, ML catches them"
    },
    {
      "file": "fig06_detection_comparison.png",
      "caption": "Recall per attack type at a 1% false-alarm budget (synthetic telemetry, modelled signatures)"
    },
    {
      "file": "fig07_on_time_vs_hops.png",
      "caption": "On-time key delivery collapses as 0.909^hops without buffering; per-hop key pools hold ~100% (supply 10x demand here; fig09 tests tight load)"
    },
    {
      "file": "fig08_pool_timeseries.png",
      "caption": "Pools drain during outages and refill after, so requests keep being served while just-in-time delivery fails whenever any hop is down"
    },
    {
      "file": "fig09_pool_sizing.png",
      "caption": "Pool size needed for on-time delivery: about 4x the mean outage reaches 94-98% even at 8 hops and 95% load"
    },
    {
      "file": "fig10_multicast_on_time.png",
      "caption": "Multicast: just-in-time falls as 0.909^N; GHZ dies past N=4; per-receiver pools stay at 94-99%"
    },
    {
      "file": "fig11_ghz_vs_bipartite.png",
      "caption": "GHZ conference keys only beat bipartite keys (max ~1.8x) behind a bottleneck with receivers within ~2 km and N<=8"
    },
    {
      "file": "fig12_hybrid_bars.png",
      "caption": "Hybrid keeps 99.6% on-time like pools while 92% of traffic is sent keyless; trade-off: stored keys age longer"
    },
    {
      "file": "fig13_hybrid_timeseries.png",
      "caption": "Hybrid: messages go keyless by QSDC while the link is up; the pool only covers outages"
    },
    {
      "file": "fig14_finite_key.png",
      "caption": "Pools allow large blocks: 1.8x more key at 100 km and key at 150-200 km where 1 s blocks give zero"
    },
    {
      "file": "fig15_memory_needed.png",
      "caption": "Buffering entanglement through 30-120 s outages needs T2 of ~1000 s or more; classical pools have no such limit"
    },
    {
      "file": "fig16_scheduling.png",
      "caption": "Growing buffer 10->120 s lifts on-time 40%->97%; adding 45% more source capacity changes it by ~2 points"
    },
    {
      "file": "fig17_design_space.png",
      "caption": "Every combination of distribution x certification x monitoring x transport x authentication x delivery, scored"
    },
    {
      "file": "fig18_qiskit_validation.png",
      "caption": "Qiskit Aer simulation of the superdense, QBER and CHSH circuits agrees with the analytic model within 3 standard errors"
    }
